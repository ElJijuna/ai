{
    "name": "@pilmee/ai",
    "version": "0.2.0",
    "description": "A friendly, zero-dependency TypeScript orchestrator for Chrome's built-in AI APIs (Prompt API, Summarizer, Writer, Rewriter, Translator, Language Detector, Proofreader) with site-scoped context and WebMCP tool support.",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "prebuild": "npm run clean",
        "build": "tsc -p tsconfig.build.json",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "biome check --write .",
        "format:check": "biome check .",
        "typecheck": "tsc --noEmit",
        "typecheck:ts6": "tsc6 --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "docs": "typedoc --options typedoc.json",
        "demo": "node scripts/demo.mjs",
        "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
    },
    "keywords": [
        "chrome-ai",
        "built-in-ai",
        "prompt-api",
        "gemini-nano",
        "webllm",
        "webmcp",
        "web-context",
        "on-device-ai",
        "typescript"
    ],
    "author": "pilmee",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ElJijuna/ai-lib.git"
    },
    "engines": {
        "node": ">=20"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "@types/node": "^26.1.1",
        "@typescript/native": "npm:typescript@^7.0.2",
        "@vitest/coverage-v8": "^3.0.0",
        "eslint": "^10.0.0",
        "jsdom": "^26.0.0",
        "super-configs": "^1.25.1",
        "typedoc": "^0.28.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "vitest": "^3.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}

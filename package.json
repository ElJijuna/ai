{
  "name": "ai-lib",
  "version": "0.1.0",
  "description": "A friendly, zero-dependency TypeScript orchestrator for Chrome's built-in AI APIs (Prompt API, Summarizer, Writer, Rewriter, Translator, Language Detector, Proofreader) with site-scoped context and WebMCP tool support.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc --options typedoc.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "chrome-ai",
    "built-in-ai",
    "prompt-api",
    "gemini-nano",
    "webllm",
    "webmcp",
    "web-context",
    "on-device-ai",
    "typescript"
  ],
  "author": "ElJijuna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElJijuna/ai-lib.git"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^10.0.0",
    "jsdom": "^26.0.0",
    "super-configs": "^1.25.1",
    "typedoc": "^0.28.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
